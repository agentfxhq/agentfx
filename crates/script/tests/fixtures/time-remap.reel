// Reverse proof fixture (tests/remap.rs): everything that moves lives in #film; the film runs
// 1.0-3.0 s forward, then `rewind` plays it back at 4x for 0.5 s (local 3.0 -> 1.0) and holds.
video "Remap proof" size=1280x720 fps=30 captions=off

scene proof dur=5s
  layer #film x=0 y=0 w=100% h=100%
    text #word "Scattered" style=display split=char x=50% y=24% anchor=center in=rise stagger=40ms at=@1.0s
    ellipse #dot w=36 h=36 fill=$mint x=30% y=46% anchor=center
    rect #box w=60 h=60 fill=$warn x=70% y=46% anchor=center
    star #st points=5 inner=0.45 size=80 fill=$accent x=85% y=70% anchor=center
    path #line d="M0 20 C 120 -20 280 60 400 20" w=400 h=40 stroke=$mint sw=8 trim=0 x=50% y=82% anchor=center
    particles #spray count=24 seed=7 x=50% y=60% speed=650 gravity=900 life=0.9s shape=confetti
  @1.0s anim #dot y 0s:0 0.8s:130~spring(170,9)
  @1.1s anim #box x 0s:0 0.9s:-200~steps(5) rot 0s:0deg 0.9s:90deg~cubic(0.3,1.4,0.6,1)
  @1.0s anim #st scale 0s:1 0.25s:1.3 repeat=4 yoyo
  @1.2s draw #line dur=1s
  @1.6s burst #spray ; hide #dot
  @3.0s rewind #film speed=4 dur=0.5s then=hold
  layer #side x=0 y=0 w=100% h=100%
    ellipse #ball w=40 h=40 fill=$mint x=10% y=20% anchor=center
  // freeze proof: #ball moves 4.0-4.8 s, frozen from 4.3 s: no change after that
  @4.0s anim #ball y 0s:0 0.8s:300~spring(170,9)
  @4.3s timemap #side 0s:0s then=hold
