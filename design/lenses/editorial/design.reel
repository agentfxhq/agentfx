// Editorial infographic (L1 lens), graphics-desk style. Tokens for Reel Script components. Essay: LENS.md
design "Editorial Infographic" base=light lens=editorial
  colors bg=#faf7f2 bg2=#f1ece3 surface=#ffffff surface2=#f6efe6 border=#d9d2c5 text=#1a1a1a muted=#57534e faint=#6f6a62 mint=#b8321f accent=#b8321f accent2=#2f5d8a danger=#b8321f warn=#a8651a ink=#1a1a1a paper=#ffffff code-bg=#1f1d1a
  bg #faf7f2
  type display="Source Serif 4" body="Libre Franklin" mono="JetBrains Mono" base=34 ratio=1.25 display-weight=600 heading-weight=600 body-weight=400 label-weight=700 display-tracking=-0.015 heading-tracking=-0.005 label-tracking=0.08 label-case=upper lh-display=1.05 lh-body=1.35
  space unit=8 scale=[8, 16, 24, 32, 48, 72, 112]
  layout radius=4 radius-sm=3 safe=7%
  surface style=flat border=2
  elevation shadow=none
  texture bg=solid grain=0
  icons style=outline stroke=2
  scale components=1.0 diagram=1.3 chart=1.2
  motion enter=out-cubic exit=in-cubic move=inout-cubic emphasis=out-quart enter-dur=0.6s exit-dur=0.3s move-dur=0.8s stagger=80ms
  skin node=tag
  treatment hairlines draw-on underline-accent caps-labels numbered
  do "Serif headline, sans everything else; kicker in red caps above the headline"
  do "Direct labels on the data and short annotations with leader lines instead of legends"
  do "Series in steel blue, the story point in vermilion; light hairline gridlines at round values"
  do "A source line under every chart"
  dont "Legends, 3D, drop shadows, gradients, rounded pill buttons"
  dont "Centered headlines or text over data; more than two hues in one chart"
  dont "Springy or bouncy motion; values must count, lines must draw"
