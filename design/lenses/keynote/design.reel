// Keynote minimal (L1 lens). Tokens for Reel Script components. Essay: LENS.md
design "Keynote Minimal" base=dark lens=keynote
  colors bg=#0b0b0c bg2=#161618 surface=#1c1c1e surface2=#2c2c2e border=#3a3a3c text=#f5f5f7 muted=#a1a1a6 faint=#86868b mint=#2997ff accent=#2997ff accent2=#48484a danger=#ff453a warn=#ffd60a ink=#0b0b0c paper=#f5f5f7 code-bg=#161618
  bg radial(at 50% 35%, #1d1d20 0%, #0b0b0c 100%)
  type display="Inter" body="Inter" mono="JetBrains Mono" base=40 ratio=1.5 display-weight=700 heading-weight=600 body-weight=400 label-weight=500 display-tracking=-0.035 heading-tracking=-0.02 label-tracking=0 label-case=none lh-display=1.02 lh-body=1.35
  space unit=8 scale=[8, 16, 32, 48, 80, 128, 208]
  layout radius=28 radius-sm=14 safe=7%
  surface style=flat border=0
  elevation shadow=none
  texture bg=radial grain=0
  icons style=plain stroke=2
  scale components=1.2 diagram=1.35 chart=1.25
  motion enter=out-cubic exit=inout-sine move=inout-cubic emphasis=out-quart enter-dur=0.9s exit-dur=0.5s move-dur=1.1s stagger=120ms
  skin node=tile
  treatment big-numbers
  do "One idea per frame; the hero word or number is the largest thing by a factor of three"
  do "Centered or single-axis compositions with wide empty margins around the subject"
  do "Grey for everything that is context, one blue for the thing being said"
  do "Long holds: a landed title stays dead still until it leaves"
  dont "Bullet lists, borders, rules, tables with lines"
  dont "More than one accent; colored backgrounds behind text"
  dont "Bounce, overshoot, fast cuts or anything that moves while the viewer reads"
