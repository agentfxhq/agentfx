// Shapes and materials under an isometric camera: flat, lambert, toon (3 bands), phong, wire;
// soft ground shadows, outlines, a point light, a slow turntable.
video "3D shapes" size=1920x1080 fps=30 captions=off
scene gallery dur=4s bg=#F3EFE6
  scene3d #lab iso ortho=6.5 light=(-4, 8, 3) ambient=0.5 outline=2 outline-color=#2B2B2B shadow=0.35 shadow-blur=10
    floor y=0 color=#E8E2D4
    group #table
      box #b1 size=1.2 x=-3 y=0.6 color=#E4572E material=flat
      sphere #s1 r=0.7 x=-1.5 y=0.7 color=#29335C material=lambert
      cylinder #c1 r=0.55 h=1.4 x=0 y=0.7 color=#F3A712 material=toon
      cone #k1 r=0.65 h=1.5 x=1.5 y=0.75 color=#669BBC material=phong specular=0.8
      torus #t1 r=0.6 tube=0.2 seg=20 x=3 y=0.8 rx=60 color=#A8C686 material=wire wire=1.5 wire-color=#2B2B2B
      box #b2 w=2 h=0.5 d=1 x=-1 y=0.25 z=2.2 bevel=0.2 color=#B388FF
      sphere #s2 r=0.5 x=1.5 y=0.5 z=2.2 color=#4CC9F0 material=toon bands=2
    light point=(0, 3, 3) color=#FFE8C2 intensity=0.4 range=6
  @0s anim #table ry 0s:0deg 4s:60deg~linear
