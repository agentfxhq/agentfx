// Blend modes in direct mode: the full W3C set (separable and non-separable) plus `plus`
// (additive). Each tile blends an orange-to-violet disc over the same striped backdrop.
video "Blend" size=1920x1080 fps=30 captions=off

scene blend dur=3s bg=#14161B
  layer #t0 w=250 h=250 x=8.5% y=15.0% anchor=center
    rect #bg0 w=250 h=250 x=0 y=0 radius=16 fill=linear(90deg, #1F6FEB 0%, #1F6FEB 33%, #E6EDF3 33%, #E6EDF3 66%, #2EA043 66%, #2EA043 100%)
    ellipse #d0 w=190 h=190 x=50% y=50% anchor=center fill=linear(135deg, #FF8A3D, #8B5CF6) blend=normal
  text #l0 "normal" size=26 weight=700 color=#FFFFFF x=8.5% y=29.0% anchor=center nowrap
  layer #t1 w=250 h=250 x=25.1% y=15.0% anchor=center
    rect #bg1 w=250 h=250 x=0 y=0 radius=16 fill=linear(90deg, #1F6FEB 0%, #1F6FEB 33%, #E6EDF3 33%, #E6EDF3 66%, #2EA043 66%, #2EA043 100%)
    ellipse #d1 w=190 h=190 x=50% y=50% anchor=center fill=linear(135deg, #FF8A3D, #8B5CF6) blend=multiply
  text #l1 "multiply" size=26 weight=700 color=#FFFFFF x=25.1% y=29.0% anchor=center nowrap
  layer #t2 w=250 h=250 x=41.7% y=15.0% anchor=center
    rect #bg2 w=250 h=250 x=0 y=0 radius=16 fill=linear(90deg, #1F6FEB 0%, #1F6FEB 33%, #E6EDF3 33%, #E6EDF3 66%, #2EA043 66%, #2EA043 100%)
    ellipse #d2 w=190 h=190 x=50% y=50% anchor=center fill=linear(135deg, #FF8A3D, #8B5CF6) blend=screen
  text #l2 "screen" size=26 weight=700 color=#FFFFFF x=41.7% y=29.0% anchor=center nowrap
  layer #t3 w=250 h=250 x=58.3% y=15.0% anchor=center
    rect #bg3 w=250 h=250 x=0 y=0 radius=16 fill=linear(90deg, #1F6FEB 0%, #1F6FEB 33%, #E6EDF3 33%, #E6EDF3 66%, #2EA043 66%, #2EA043 100%)
    ellipse #d3 w=190 h=190 x=50% y=50% anchor=center fill=linear(135deg, #FF8A3D, #8B5CF6) blend=overlay
  text #l3 "overlay" size=26 weight=700 color=#FFFFFF x=58.3% y=29.0% anchor=center nowrap
  layer #t4 w=250 h=250 x=74.9% y=15.0% anchor=center
    rect #bg4 w=250 h=250 x=0 y=0 radius=16 fill=linear(90deg, #1F6FEB 0%, #1F6FEB 33%, #E6EDF3 33%, #E6EDF3 66%, #2EA043 66%, #2EA043 100%)
    ellipse #d4 w=190 h=190 x=50% y=50% anchor=center fill=linear(135deg, #FF8A3D, #8B5CF6) blend=darken
  text #l4 "darken" size=26 weight=700 color=#FFFFFF x=74.9% y=29.0% anchor=center nowrap
  layer #t5 w=250 h=250 x=91.5% y=15.0% anchor=center
    rect #bg5 w=250 h=250 x=0 y=0 radius=16 fill=linear(90deg, #1F6FEB 0%, #1F6FEB 33%, #E6EDF3 33%, #E6EDF3 66%, #2EA043 66%, #2EA043 100%)
    ellipse #d5 w=190 h=190 x=50% y=50% anchor=center fill=linear(135deg, #FF8A3D, #8B5CF6) blend=lighten
  text #l5 "lighten" size=26 weight=700 color=#FFFFFF x=91.5% y=29.0% anchor=center nowrap
  layer #t6 w=250 h=250 x=8.5% y=46.0% anchor=center
    rect #bg6 w=250 h=250 x=0 y=0 radius=16 fill=linear(90deg, #1F6FEB 0%, #1F6FEB 33%, #E6EDF3 33%, #E6EDF3 66%, #2EA043 66%, #2EA043 100%)
    ellipse #d6 w=190 h=190 x=50% y=50% anchor=center fill=linear(135deg, #FF8A3D, #8B5CF6) blend=color-dodge
  text #l6 "color-dodge" size=26 weight=700 color=#FFFFFF x=8.5% y=60.0% anchor=center nowrap
  layer #t7 w=250 h=250 x=25.1% y=46.0% anchor=center
    rect #bg7 w=250 h=250 x=0 y=0 radius=16 fill=linear(90deg, #1F6FEB 0%, #1F6FEB 33%, #E6EDF3 33%, #E6EDF3 66%, #2EA043 66%, #2EA043 100%)
    ellipse #d7 w=190 h=190 x=50% y=50% anchor=center fill=linear(135deg, #FF8A3D, #8B5CF6) blend=color-burn
  text #l7 "color-burn" size=26 weight=700 color=#FFFFFF x=25.1% y=60.0% anchor=center nowrap
  layer #t8 w=250 h=250 x=41.7% y=46.0% anchor=center
