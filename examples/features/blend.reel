  layer #t10 w=250 h=250 x=74.9% y=46.0% anchor=center
    rect #bg10 w=250 h=250 x=0 y=0 radius=16 fill=linear(90deg, #1F6FEB 0%, #1F6FEB 33%, #E6EDF3 33%, #E6EDF3 66%, #2EA043 66%, #2EA043 100%)
    ellipse #d10 w=190 h=190 x=50% y=50% anchor=center fill=linear(135deg, #FF8A3D, #8B5CF6) blend=difference
  text #l10 "difference" size=26 weight=700 color=#FFFFFF x=74.9% y=60.0% anchor=center nowrap
  layer #t11 w=250 h=250 x=91.5% y=46.0% anchor=center
    rect #bg11 w=250 h=250 x=0 y=0 radius=16 fill=linear(90deg, #1F6FEB 0%, #1F6FEB 33%, #E6EDF3 33%, #E6EDF3 66%, #2EA043 66%, #2EA043 100%)
    ellipse #d11 w=190 h=190 x=50% y=50% anchor=center fill=linear(135deg, #FF8A3D, #8B5CF6) blend=exclusion
  text #l11 "exclusion" size=26 weight=700 color=#FFFFFF x=91.5% y=60.0% anchor=center nowrap
  layer #t12 w=250 h=250 x=8.5% y=77.0% anchor=center
    rect #bg12 w=250 h=250 x=0 y=0 radius=16 fill=linear(90deg, #1F6FEB 0%, #1F6FEB 33%, #E6EDF3 33%, #E6EDF3 66%, #2EA043 66%, #2EA043 100%)
    ellipse #d12 w=190 h=190 x=50% y=50% anchor=center fill=linear(135deg, #FF8A3D, #8B5CF6) blend=hue
  text #l12 "hue" size=26 weight=700 color=#FFFFFF x=8.5% y=91.0% anchor=center nowrap
  layer #t13 w=250 h=250 x=25.1% y=77.0% anchor=center
    rect #bg13 w=250 h=250 x=0 y=0 radius=16 fill=linear(90deg, #1F6FEB 0%, #1F6FEB 33%, #E6EDF3 33%, #E6EDF3 66%, #2EA043 66%, #2EA043 100%)
    ellipse #d13 w=190 h=190 x=50% y=50% anchor=center fill=linear(135deg, #FF8A3D, #8B5CF6) blend=saturation
  text #l13 "saturation" size=26 weight=700 color=#FFFFFF x=25.1% y=91.0% anchor=center nowrap
  layer #t14 w=250 h=250 x=41.7% y=77.0% anchor=center
    rect #bg14 w=250 h=250 x=0 y=0 radius=16 fill=linear(90deg, #1F6FEB 0%, #1F6FEB 33%, #E6EDF3 33%, #E6EDF3 66%, #2EA043 66%, #2EA043 100%)
    ellipse #d14 w=190 h=190 x=50% y=50% anchor=center fill=linear(135deg, #FF8A3D, #8B5CF6) blend=color
  text #l14 "color" size=26 weight=700 color=#FFFFFF x=41.7% y=91.0% anchor=center nowrap
  layer #t15 w=250 h=250 x=58.3% y=77.0% anchor=center
    rect #bg15 w=250 h=250 x=0 y=0 radius=16 fill=linear(90deg, #1F6FEB 0%, #1F6FEB 33%, #E6EDF3 33%, #E6EDF3 66%, #2EA043 66%, #2EA043 100%)
    ellipse #d15 w=190 h=190 x=50% y=50% anchor=center fill=linear(135deg, #FF8A3D, #8B5CF6) blend=luminosity
  text #l15 "luminosity" size=26 weight=700 color=#FFFFFF x=58.3% y=91.0% anchor=center nowrap
  layer #t16 w=250 h=250 x=74.9% y=77.0% anchor=center
    rect #bg16 w=250 h=250 x=0 y=0 radius=16 fill=linear(90deg, #1F6FEB 0%, #1F6FEB 33%, #E6EDF3 33%, #E6EDF3 66%, #2EA043 66%, #2EA043 100%)
    ellipse #d16 w=190 h=190 x=50% y=50% anchor=center fill=linear(135deg, #FF8A3D, #8B5CF6) blend=plus
