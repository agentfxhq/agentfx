  layer #t9 w=250 h=250 x=58.3% y=46.0% anchor=center
    rect #bg9 w=250 h=250 x=0 y=0 radius=16 fill=linear(90deg, #1F6FEB 0%, #1F6FEB 33%, #E6EDF3 33%, #E6EDF3 66%, #2EA043 66%, #2EA043 100%)
    ellipse #d9 w=190 h=190 x=50% y=50% anchor=center fill=linear(135deg, #FF8A3D, #8B5CF6) blend=soft-light
