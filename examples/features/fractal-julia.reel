// Generators: a breathing Julia set. c drifts along the edge of the Mandelbrot set, the palette cycles.
video "Julia" size=1280x720 fps=30 captions=off
theme studio-dark
  bg #000000

scene julia dur=6s
  gen #j kind=julia cx=-0.8 cy=0.156 zoom=1.3 iter=400 bailout=256 color-speed=1.4 palette=vapor
  anim #j cx 0s:-0.8 3s:-0.745 6s:-0.8 ease=inout-sine
  anim #j cy 0s:0.156 3s:0.11 6s:0.156 ease=inout-sine
  anim #j color-offset 0s:0 6s:1 ease=linear
  anim #j turn 0s:0 6s:20 ease=inout-sine
