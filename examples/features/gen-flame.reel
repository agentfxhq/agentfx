// Generators: fractal flames. A seeded IFS of affine maps with blended variations; the chaos game
// accumulates into glowing silk. morph turns every map by whole turns (0 -> 1 loops seamlessly).
video "Fractal flame" size=1280x720 fps=30 captions=off
theme studio-dark
  bg #05010f

scene silk dur=6s
  gen #f kind=flame palette=vapor seed=12
  anim #f morph 0s:0 6s:0.2 ease=linear
  anim #f color-offset 0s:0 6s:0.3 ease=linear

scene mandala dur=6s
  gen #m kind=flame symmetry=5 palette=neon seed=12
  anim #m morph 0s:0 6s:0.25 ease=linear
  anim #m turn 0s:0 6s:-36 ease=linear
