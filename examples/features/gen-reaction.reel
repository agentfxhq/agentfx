// Generators: Gray-Scott reaction-diffusion growing from seeded colonies. Frame t is step
// warmup + floor(t * speed): a pure function of t, so scrubbing matches a sequential render.
video "Reaction diffusion" size=1280x720 fps=30 captions=off
theme studio-dark
  bg #000000

scene coral dur=6s
  gen #r kind=reaction preset=coral palette=vapor seed=5

scene zebra dur=6s
  gen #z kind=reaction preset=zebra palette=acid seed=11 speed=300
  anim #z color-offset 0s:0 6s:0.25 ease=linear
