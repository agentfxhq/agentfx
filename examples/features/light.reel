// Light on flat design: a low light travels across a flat poster/UI; every card casts a
// soft SDF shadow (higher cards: longer, softer) that swings with the light; a warm sweep
// crosses the hero card; then a dark plate with a knocked-out word lets the light through
// as god rays.
video "Light" size=1920x1080 fps=30 captions=off

scene ui dur=5s bg=#ECE6DA
  light #sun x=-12% y=30% z=520 radius=110
  @0s anim #sun x 0s:0 5s:2450~inout-sine
  @0s anim #sun y 0s:0 2.5s:-430~out-sine 5s:0~in-sine
  rect #hero w=1000 h=660 x=4% y=8% radius=40 fill=#FF5B3A shadow=soft(#sun, height=70, opacity=0.36, color=#3A2210)
    anim y 0s:90 0.9s:0~spring(150,16)
  text #h1 "Flat," size=240 weight=900 color=#1C1A22 x=8% y=17% nowrap
    anim y 0s:150 1.0s:0~spring(150,16)
  text #h2 "lit." size=240 weight=900 color=#FFF4E8 x=8% y=40% nowrap shadow=soft(#sun, height=22, opacity=0.32, color=#3A2210)
    anim y 0s:190 1.1s:0~spring(150,16)
  rect #c1 w=640 h=270 x=61% y=7% radius=30 fill=#FFFFFF shadow=soft(#sun, height=45, opacity=0.32, color=#3A2210)
    anim x 0s:420 0.9s:0~spring(160,16)
  rect #c2 w=640 h=300 x=61% y=40% radius=30 fill=#2B59FF shadow=soft(#sun, height=120, opacity=0.36, color=#3A2210)
    anim x 0s:520 1.0s:0~spring(150,15)
  ellipse #dot w=330 h=330 x=49% y=80% anchor=center fill=#FFC93C shadow=soft(#sun, height=170, opacity=0.36, color=#3A2210)
    anim scale 0s:0.3 1.0s:1~spring(200,12)
  rect #bar w=1720 h=44 x=4% y=91% radius=22 fill=#1C1A22 shadow=soft(#sun, height=14, opacity=0.3, color=#3A2210)
    anim x 0s:-1800 0.8s:0~out-cubic
  @1.0s sweep #hero dur=1.6s angle=18deg width=26% color=#FFF0D2 strength=0.3
  @2.2s sweep #c2 dur=1.3s angle=18deg width=22% color=#FFF0D2 strength=0.3

scene rays dur=4s bg=#ECE6DA
  light #lamp x=50% y=50% z=900 radius=60
  @0s anim #lamp x 0s:-460 4s:460~inout-sine
  @0s anim #lamp y 0s:120 4s:-120~inout-sine
  layer #plate x=0 y=0 w=100% h=100% fill=#121018 rays=#lamp rays-length=0.6 rays-strength=1.1 rays-color=#FFD9A0
    text #word "LIGHT" size=470 weight=900 color=#000 x=50% y=50% anchor=center nowrap tracking=-0.03 knockout
      anim scale 0s:0.92 4s:1.06
  @0s anim #plate rays 0s:0 0.8s:1.1~out-cubic
