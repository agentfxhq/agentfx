// Motion paths: `move #x along=...` follows a path by arc length (the ease is on the distance),
// `orient` turns the element to the tangent (`orient=90deg` adds an offset). Path data is relative
// to where the element is; `along=#road` follows another path element's geometry with the center.
video "Motion paths" size=1920x1080 fps=30 captions=off

scene paths dur=6s bg=#0E1116
  // a visible guide road; the arrow points along +x, so plain `orient`
  path #road d="M0 300 C200 0 400 600 600 300 S1000 0 1200 300" w=1200 h=600 x=50% y=60% anchor=center stroke=#2A3340 sw=10 dash=[18,12]
  path #car d="M0 0 L90 30 L0 60 L18 30 Z" w=90 h=60 fill=#FFE45B x=18.75% y=60% anchor=center
  @0.4s move #car along=#road orient dur=4.6s ease=inout-sine
  // a loop-the-loop with relative path data; this arrow points up, so orient=90deg
  path #plane d="M24 0 L48 72 L24 58 L0 72 Z" w=48 h=72 fill=#5BD0FF x=8% y=34% anchor=center
  @0.4s move #plane along="M0 0 C220 0 380 -40 420 -120 C460 -220 340 -280 290 -200 C240 -120 330 0 520 0 L1500 0" orient=90deg dur=4.6s ease=inout-cubic
  // constant speed along a wave, no orient
  ellipse #dot w=36 h=36 fill=#FF48B0 x=8% y=88% anchor=center
  @0.4s move #dot along="M0 0 C100 -80 200 -80 300 0 S500 80 600 0 S800 -80 900 0 S1100 80 1200 0 S1400 -80 1500 0" dur=4.6s ease=linear
