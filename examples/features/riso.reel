// Risograph (reel-ir riso): the whole scene printed in three spot inks with seeded
// misregistration that drifts, ink grain and density variation. Overlaps multiply.
video "Riso" size=1920x1080 fps=30 captions=off

scene poster dur=6s bg=#F4EFE6 riso=[#FF48B0, #0078BF, #FFE800] misreg=14 riso-drift=5 riso-speed=0.4 riso-grain=0.45 riso-density=0.3 seed=7
  ellipse #disc w=980 h=980 x=66% y=46% anchor=center fill=#FFE800
    anim scale 0s:0.55 1.4s:1~spring(110,13) 6s:1.12
    anim x 0s:0 6s:-420~inout-sine
  rect #band w=2600 h=300 x=50% y=63% anchor=center rot=-11 fill=#FF48B0 blend=multiply
    anim x 0s:-1400 1.1s:0~out-cubic 6s:160
    anim rot 0s:-11 6s:-3~inout-sine
  text #big "RISO" size=600 weight=900 color=#0078BF x=47% y=40% anchor=center blend=multiply nowrap tracking=-0.05
    anim y 0s:420 1.2s:0~spring(150,15)
    anim rot 0s:-6 1.2s:0~spring(150,15)
    anim scale 1.2s:1 6s:1.08
  text #kick "INK · PAPER · DRIFT" size=70 weight=800 color=#0078BF x=5% y=86% blend=multiply nowrap
    anim x 0s:-700 1.0s:0~out-cubic 6s:60
  text #no "Nº 07" size=150 weight=900 color=#FF48B0 x=95% y=7% anchor=top-right blend=multiply nowrap
    anim y 0s:-260 0.9s:0~spring(170,16)
  ellipse #dot w=180 h=180 x=12% y=14% anchor=center fill=#FF48B0 blend=multiply
    anim scale 0s:0 2.6s:0 3.2s:1~spring(220,12)
    anim x 3.2s:0 6s:260~inout-sine
