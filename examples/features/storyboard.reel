// Storyboard notes and what `agentfx storyboard` reads from the tracks.
//   agentfx storyboard examples/features/storyboard.reel -o out/storyboard.png
// Scene `open` has its shots set by timed notes; `orbit` and `outro` are found from the IR
// (scene start, transition, a hard change at 3 s in `orbit`), with automatic notes.
video "Storyboard demo" size=1280x720 fps=30 captions=off

scene open dur=8s bg=#101418 note="title rises into frame"
  text #title "LAUNCH DAY" x=50% y=46% anchor=center size=120 weight=800 color=#F4F1E6
  rect #bar x=340 y=430 w=600 h=10 fill=#E8553D
  rect #card x=120 y=520 w=320 h=120 radius=18 fill=#2A3340
  ellipse #dot x=1040 y=150 w=90 h=90 fill=#F2C14E
  @0s anim #title y 0s:140 1.4s:0~out-cubic opacity 0s:0 0.6s:1
  @0s anim #bar sx 0s:0 1.6s:1~out-expo
  @3s note "card slides in, the dot spins"
  @3s anim #card x 0s:-420 1.2s:0~out-back
  @3s anim #dot rot 0s:0 2.4s:720~inout-cubic
  @5.5s note "push in on the title"
  @5.5s anim #title scale 0s:1 2.4s:1.25~inout-sine

scene orbit dur=7s bg=#0B0D12 in=fade
  layer #world x=0 y=0 w=1280 h=720
    rect #grid x=0 y=420 w=1280 h=300 fill=#1C2230
    ellipse #planet x=520 y=180 w=240 h=240 fill=#5DA9E9
    rect #ship x=120 y=560 w=120 h=40 radius=8 fill=#F4F1E6
  rect #flash x=0 y=0 w=1280 h=720 fill=#FFFFFF opacity=0
  @0s anim #world scale 0s:1 2.8s:1.5~inout-sine
  @0s anim #ship x 0s:0 2.8s:900~inout-cubic y 0s:0 2.8s:-120~inout-cubic
  @2.9s anim #flash opacity 0s:0 0.08s:0.9 0.5s:0
  @3s hide #world
  @3s show #stars
  cloud #stars n=400 seed=3 r=1.6 palette=[#F4F1E6, #5DA9E9] opacity=0
    form 0s cluster x=50% y=50% sx=4% sy=4%
    form 3.2s sphere x=50% y=50% r=34% dur=1.2s ease=out-expo
  @3s anim #stars opacity 0s:0 0.01s:1

scene outro dur=4s bg=#F4F1E6 in=cut
  text #end "SEE YOU THERE" x=50% y=50% anchor=center size=96 weight=800 color=#101418
  @0s anim #end scale 0s:0.6 1.2s:1~out-back opacity 0s:0 0.4s:1
  @2.6s exit #end fade
