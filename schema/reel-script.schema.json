{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentfx.dev/schema/reel-script-0.json",
  "title": "Reel Script v0 (JSON form)",
  "description": "1:1 JSON form of the Reel Script text format. Every node is {kind, args, props, body, children}. Value spellings are the same as in text form (\"0.4s\", \"#17845a\", \"$accent\", \"@Reiter+0.2s\"). Typing happens against the catalog (`agentfx catalog`).",
  "type": "object",
  "required": [
    "nodes"
  ],
  "properties": {
    "reel": {
      "const": "0"
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/node"
      }
    }
  },
  "$defs": {
    "value": {
      "oneOf": [
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "type": "boolean"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/value"
          }
        }
      ]
    },
    "node": {
      "type": "object",
      "required": [
        "kind"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "description": "element, verb or document node; `at` = event anchor (args[0] = anchor expression)",
          "examples": [
            "activate",
            "advance",
            "anim",
            "animate",
            "assemble",
            "at",
            "bg",
            "body",
            "box",
            "browser",
            "burst",
            "callout",
            "camera",
            "camera3d",
            "card",
            "chapter",
            "chapterbar",
            "chart",
            "circle",
            "click",
            "cloud",
            "code",
            "col",
            "colors",
            "cone",
            "count",
            "counter",
            "cube",
            "cursor",
            "cylinder",
            "dblclick",
            "deactivate",
            "device",
            "diagram",
            "diff",
            "display",
            "dolly",
            "done",
            "drag",
            "draw",
            "drop",
            "echo",
