          ]
        },
        "args": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/value"
          }
        },
        "props": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/value"
          }
        },
        "body": {
          "type": "string"
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          }
        }
      }
    }
  }
}
