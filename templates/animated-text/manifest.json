{
  "id": "animated-text",
  "title": "Animated text",
  "description": "Kinetic typography for one headline: rise, focus, slide or cinematic, with a clean exit.",
  "tags": ["text", "animated text", "kinetic typography", "title", "typography"],
  "formats": ["16:9", "9:16", "1:1"],
  "duration_s": 5,
  "params": [
    {"id": "text", "type": "text", "label": "Headline", "default": "Make every word move", "max_len": 60, "required": true},
    {"id": "kicker", "type": "text", "label": "Kicker (optional)", "default": "Kinetic type", "max_len": 32},
    {"id": "style", "type": "enum", "label": "Style", "default": "rise", "options": ["rise", "focus", "slide", "cinematic"]},
    {"id": "upper", "type": "enum", "label": "Uppercase", "default": "no", "options": ["no", "yes"]},
    {"id": "speed", "type": "number", "label": "Speed", "default": 1, "min": 0.5, "max": 2, "step": 0.1},
    {"id": "duration", "type": "number", "label": "Length (s)", "default": 5, "min": 3, "max": 12, "step": 0.5},
    {"id": "color", "type": "color", "label": "Text colour", "default": "#F5F1E8"},
    {"id": "accent", "type": "color", "label": "Accent", "default": "#FF5A36"},
    {"id": "bg", "type": "color", "label": "Background", "default": "#141210"}
  ]
}
