{
  "id": "chart-animated",
  "title": "Animated chart",
  "description": "Bars grow, lines draw and the donut fills while the values count up: a data clip from a small table.",
  "tags": ["chart", "animated chart", "chart animation", "data video", "bar chart race", "diagramm animiert"],
  "formats": ["16:9", "9:16", "1:1"],
  "duration_s": 10,
  "params": [
    {"id": "title", "type": "text", "label": "Title", "default": "Monthly active users", "max_len": 60, "required": true},
    {"id": "subtitle", "type": "text", "label": "Subtitle", "default": "Thousands, H1 2026", "max_len": 90},
    {"id": "type", "type": "enum", "label": "Chart", "default": "bar", "options": ["bar", "line", "area", "donut"]},
    {"id": "rows", "type": "data", "label": "Data (label, value)", "min_rows": 1, "max_rows": 16,
     "columns": [{"id": "label", "type": "text", "max_len": 16}, {"id": "value", "type": "number"}],
     "default": [{"label": "Jan", "value": 42}, {"label": "Feb", "value": 48}, {"label": "Mar", "value": 57},
                 {"label": "Apr", "value": 61}, {"label": "May", "value": 74}, {"label": "Jun", "value": 89}]},
    {"id": "unit", "type": "text", "label": "Unit after values", "default": "k", "max_len": 8},
    {"id": "highlight", "type": "number", "label": "Highlighted row (0 = none)", "default": 6, "min": 0, "max": 16, "step": 1},
    {"id": "source", "type": "text", "label": "Source line", "default": "Source: product analytics", "max_len": 80},
    {"id": "locale", "type": "enum", "label": "Number format", "default": "en", "options": ["en", "de"]},
    {"id": "bg", "type": "color", "label": "Background", "default": "#0E1726"},
    {"id": "ink", "type": "color", "label": "Text colour", "default": "#F1F5FB"},
    {"id": "color", "type": "color", "label": "Series colour", "default": "#5B8CFF"},
    {"id": "accent", "type": "color", "label": "Highlight colour", "default": "#3CE0A0"}
  ]
}
