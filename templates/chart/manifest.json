{
  "id": "chart",
  "kind": "still",
  "title": "Chart",
  "description": "Bar, line, area, donut or KPI tiles from a small table, with title, unit and source, in social and slide sizes.",
  "tags": ["chart", "chart maker", "diagramm erstellen", "bar chart", "line chart", "donut", "kpi", "infographic"],
  "sizes": ["instagram-post", "instagram-portrait", "story", "linkedin-post", "x-post", "og-image", "full-hd"],
  "still_at": "0s",
  "params": [
    {"id": "title", "type": "text", "label": "Title", "default": "Monthly active users", "max_len": 70, "required": true},
    {"id": "subtitle", "type": "text", "label": "Subtitle", "default": "First half of 2026, in thousands", "max_len": 64},
    {"id": "type", "type": "enum", "label": "Chart", "default": "bar", "options": ["bar", "line", "area", "donut", "kpi"]},
    {"id": "rows", "type": "data", "label": "Data (label, value; KPI: label, value, delta)", "min_rows": 1, "max_rows": 12,
     "columns": [{"id": "label", "type": "text", "max_len": 12}, {"id": "value", "type": "number"}, {"id": "delta", "type": "text", "max_len": 12}],
     "default": [{"label": "Jan", "value": 42}, {"label": "Feb", "value": 48}, {"label": "Mar", "value": 57},
                 {"label": "Apr", "value": 61}, {"label": "May", "value": 74}, {"label": "Jun", "value": 89}]},
    {"id": "unit", "type": "text", "label": "Unit after values (k, %, EUR)", "default": "k", "max_len": 4},
    {"id": "highlight", "type": "number", "label": "Highlighted row (0 = none)", "default": 6, "min": 0, "max": 12, "step": 1},
    {"id": "source", "type": "text", "label": "Source line", "default": "Source: product analytics", "max_len": 80},
    {"id": "brand", "type": "text", "label": "Brand or author", "default": "Northwind", "max_len": 28},
    {"id": "locale", "type": "enum", "label": "Number format", "default": "en", "options": ["en", "de"]},
    {"id": "bg", "type": "color", "label": "Background", "default": "#0E1726"},
    {"id": "ink", "type": "color", "label": "Text colour", "default": "#F1F5FB"},
    {"id": "color", "type": "color", "label": "Series colour", "default": "#5B8CFF"},
    {"id": "accent", "type": "color", "label": "Highlight colour", "default": "#3CE0A0"}
  ]
}
