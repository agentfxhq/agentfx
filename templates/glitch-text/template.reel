// Glitch text (AgentFX template): a word that boots up through a corrupted signal, holds with
// short seeded bursts of block displacement and channel split, and cuts out at the end.
video "{{text}}" size=1920x1080 fps=30 captions=off formats=[16:9, 9:16, 1:1]

scene glitch dur=6s bg=radial(at 50% 48%, {{bg.rgb}} 0%, {{bg.rgb}} 50%, #000000 140%) optics vignette=0.5 film-grain=0.05 seed={{seed}}
  // a thin carrier line through the word, flickering with the signal
  rect #carrier w=100% h=2 x=0 y=48% anchor=left fill=linear(90deg, {{accent.rgb}}00 0%, {{accent.rgb}}AA 50%, {{accent.rgb}}00 100%) opacity=0.6
    anim opacity 0s:0 0.5s:0 0.55s:0.8 0.9s:0.25~out-cubic 1.6s:0.25 1.62s:0.9 2s:0.25~out-cubic 5.6s:0.25 5.62s:1 5.8s:0
  layer #sig x=0 y=0 w=100% h=100% glitch=0 glitch-rate=14 glitch-block=36 seed={{seed}}{{^style=mono}} rgbsplit=0 rgbsplit-dx=0 rgbsplit-mode=linear{{/style=mono}} dblur=0
{{^style=mono}}
    text #ghost "{{text}}" size=240 weight=900 color={{accent.rgb}} tracking=-0.03 x=50% y=48% anchor=center w=84% lh=0.95 align=center upper opacity=0 blend=screen
      anim opacity 0s:0.9 0.7s:0~out-cubic 1.6s:0 1.62s:0.85 1.9s:0~out-cubic 3.1s:0 3.12s:0.9 3.4s:0~out-cubic 4.44s:0 4.46s:0.7 4.7s:0~out-cubic 5.5s:0 5.6s:1
      anim x 0s:-30 0.1s:22 0.2s:-12 0.3s:30 0.45s:-8 0.6s:0~steps(1) 1.62s:26 1.7s:-18 1.8s:8 1.9s:0~steps(1) 3.12s:-34 3.2s:20 3.3s:-6 3.4s:0~steps(1) 4.46s:18 4.56s:-10 4.7s:0~steps(1) 5.6s:-40 5.7s:30 5.8s:-20
{{/style=mono}}
    text #word "{{text}}" size=240 weight=900 color={{color}} tracking=-0.03 x=50% y=48% anchor=center w=84% lh=0.95 align=center upper{{#style=signal}} stroke={{accent.rgb}} sw=2{{/style=signal}}
      anim opacity 0s:0 0.08s:1 0.16s:0.2 0.24s:1 0.42s:0.35 0.5s:1~steps(1) 5.62s:1 5.66s:0.3 5.72s:1 5.8s:0~steps(1)
{{#sub}}
    text #sub "{{sub}}" size=40 weight=600 color={{accent}} tracking=0.42 x=50% y=64% anchor=center w=80% fit nowrap align=center upper
{{/sub}}
  // intensity envelope: hard at the boot, short bursts in the hold, a crash at the cut
  anim #sig glitch 0s:{{= 0.9 * intensity}} 0.55s:{{= 0.75 * intensity}} 0.7s:0~out-expo 1.55s:0 1.6s:{{= 0.7 * intensity}} 1.78s:0~out-cubic 2.3s:0 2.33s:{{= 0.35 * intensity}} 2.4s:0 2.9s:0 2.94s:{{= 0.45 * intensity}} 3.04s:0 3.12s:{{= 0.8 * intensity}} 3.3s:0~out-cubic 3.9s:0 3.93s:{{= 0.3 * intensity}} 4.0s:0 4.4s:0 4.44s:{{= 0.55 * intensity}} 4.6s:0~out-cubic 4.95s:0 4.98s:{{= 0.35 * intensity}} 5.05s:0 5.5s:0 5.6s:{{= 1.0 * intensity}}
  anim #sig glitch-block 0s:60 0.6s:24 1.6s:90 1.8s:30 3.1s:120 3.3s:40 4.44s:70 5.6s:140
{{^style=mono}}
  anim #sig rgbsplit 0s:1 0.7s:0.25~out-cubic 1.6s:0.25 1.62s:1 1.9s:0.25~out-cubic 3.1s:0.25 3.12s:1 3.4s:0.25~out-cubic 4.44s:0.25 4.46s:1 4.7s:0.25~out-cubic 5.5s:0.25 5.6s:1
  anim #sig rgbsplit-dx 0s:{{= 34 * intensity}} 0.7s:{{= 4 * intensity}}~out-cubic 1.6s:{{= 4 * intensity}} 1.62s:{{= -28 * intensity}} 1.9s:{{= 4 * intensity}}~out-cubic 3.1s:{{= 4 * intensity}} 3.12s:{{= 40 * intensity}} 3.4s:{{= 4 * intensity}}~out-cubic 4.44s:{{= 4 * intensity}} 4.46s:{{= -22 * intensity}} 4.7s:{{= 4 * intensity}}~out-cubic 5.5s:{{= 4 * intensity}} 5.6s:{{= 60 * intensity}}
{{/style=mono}}
  anim #sig dblur 0s:0 1.6s:0 1.62s:{{= 70 * intensity}} 1.75s:0~out-cubic 3.12s:0 3.14s:{{= 110 * intensity}} 3.3s:0~out-cubic 5.6s:0 5.66s:{{= 160 * intensity}}
  anim #sig x 0s:0 1.6s:0 1.62s:-26 1.66s:18 1.7s:0~steps(1) 3.12s:0 3.14s:34 3.18s:-12 3.22s:0~steps(1)
  anim #sig scale 0s:1.04 6s:1~linear
  @0.2s temporalglitch #sig span=0.25s block=32 intensity={{= 0.8 * intensity}} smear=0.6 stutter=0.12 rgb=0.4 scanline=0.35 seed={{seed}}
  when portrait
    set #word size=220
{{^style=mono}}
    set #ghost size=220
{{/style=mono}}
{{#sub}}
    set #sub y=66%
{{/sub}}
