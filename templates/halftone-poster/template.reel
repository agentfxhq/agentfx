// Halftone poster (AgentFX template): a bold poster printed as halftone dots. The screen starts
// coarse (only the big shapes read), resolves to a fine print, and the layout settles into place.
video "{{title}}" size=1920x1080 fps=30 captions=off formats=[16:9, 9:16, 1:1]

scene poster dur=6s bg={{paper}}
  layer #art x=0 y=0 w=100% h=100% halftone=140 halftone-mode={{mode}} halftone-angle={{angle}}deg halftone-ink={{ink}} halftone-paper={{paper}}
{{#image}}
    image #photo src={{image}} w=100% h=100% x=0 y=0 fit=cover
      anim scale 0s:1.25 6s:1.05~out-cubic
{{/image}}
    ellipse #disc w=1100 h=1100 x=30% y=52% anchor=center fill=radial(at 35% 30%, {{color2}} 0%, {{color1}} 70%){{#image}} opacity=0.85 blend=multiply{{/image}}
      anim scale 0s:0.7 1.8s:1~out-cubic 6s:1.06
      anim x 0s:-160 6s:60~out-cubic
    rect #band w=2600 h=180 x=50% y=74% anchor=center rot=-8 fill={{ink}}
      anim x 0s:-900 1.4s:0~out-cubic 6s:120
    text #title "{{title}}" size={{= round(clamp(3400 / max(title_len, 1), 140, 300))}} weight=900 color={{ink}} tracking=-0.04 lh=0.9 x=63% y=40% anchor=center w=56% align=center upper
      anim y 0s:160 1.6s:0~out-cubic
      anim scale 1.6s:1 6s:1.04
    text #sub "{{sub}}" size=46 weight=800 color={{paper}} tracking=0.3 upper x=50% y=74% anchor=center w=80% fit nowrap align=center rot=-8
      anim opacity 0s:0 1.2s:0 1.8s:1
  anim #art halftone 0s:140 1.4s:90~inout-sine 4.2s:{{fine}}~inout-cubic
  when portrait
    set #disc w=900 h=900 x=50% y=30%
    set #title x=50% y=56% w=80% size={{= round(clamp(2600 / max(title_len, 1), 120, 260))}}
    set #band y=84%
    set #sub y=84%
  when square
    set #disc w=700 h=700 x=40% y=40%
    set #title x=54% y=52% w=74% size={{= round(clamp(2200 / max(title_len, 1), 100, 220))}}
    set #band y=82%
    set #sub y=82%
