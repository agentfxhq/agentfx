// Logo reveal (AgentFX template): the logo flies together from shards (a shatter played backwards)
// or wipes on behind a light sweep, settles with a soft glow, and the tagline follows.
video "{{brand}}" size=1920x1080 fps=30 captions=off formats=[16:9, 9:16, 1:1]

scene reveal dur=5s bg=radial(at 50% 45%, {{bg2}} 0%, {{bg}} 70%)
  ellipse #halo w=1400 h=1400 x=50% y=45% anchor=center fill=radial(at 50% 50%, {{accent.rgb}}40 0%, {{accent.rgb}}00 62%) opacity=0
    anim opacity 1.0s:0 2.0s:1~out-cubic
    anim scale 1.0s:0.8 5s:1.1~out-cubic
  layer #film x=0 y=0 w=100% h=100%
{{#logo}}
    image #mark src={{logo}} w=760 h=380 x=50% y=45% anchor=center fit=contain
{{/logo}}
{{^logo}}
    text #mark "{{brand}}" size={{= round(clamp(2400 / max(brand_len, 1), 80, 200))}} weight=900 color={{text_color}} tracking=-0.04 x=50% y=45% anchor=center nowrap
{{/logo}}
{{#tagline}}
  text #tag "{{tagline}}" size=44 weight=600 color={{text_color.rgb}}CC tracking=0.3 upper x=50% y=70% anchor=center w=80% fit nowrap align=center
{{/tagline}}
  anim #film scale 1.6s:1 5s:1.04~out-sine
{{#style=assemble}}
{{#logo}}
  // an uploaded logo flies together from shards: a shatter played backwards
  @0s shatter #mark pieces=36 seed={{seed}} origin=50%,55% force=900 gravity=0 spin=200 walls=none
  @0s timemap #film 0s:1.6s 1.6s:0s~out-cubic then=hold
{{/logo}}
{{^logo}}
  // a text logo assembles letter by letter, each from its own spin, scale and blur
  @0s animate #mark by=char order=random seed={{seed}} shape=ramp-up range=0%..45% offset=-45%..100% dur=1.5s ease=out-cubic opacity=0 scale=2.2 rot=-40 y=-80 blur=24
{{/logo}}
  anim #film opacity 0s:0 0.4s:1~out-cubic
  @1.6s sweep #mark dur=1.1s angle=20deg width=18% strength=0.6 color={{accent}}
{{/style=assemble}}
{{#style=sweep}}
  @0s enter #mark wipe dur=1.4s
  @0.3s sweep #mark dur=1.6s angle=20deg width=22% strength=0.7 color={{accent}}
  anim #mark blur 0s:16 1.2s:0~out-cubic
{{/style=sweep}}
{{#tagline}}
  @2.1s animate #tag by=char shape=ramp-up range=0%..25% offset=-25%..100% dur=1.0s ease=linear opacity=0 y=20 blur=6
{{/tagline}}
  when portrait
{{^logo}}
    set #mark size={{= round(clamp(1500 / max(brand_len, 1), 54, 170))}}
{{/logo}}
{{#logo}}
    set #mark w=840 h=420
{{/logo}}
{{#tagline}}
    set #tag y=62%
{{/tagline}}
  when square
{{^logo}}
    set #mark size={{= round(clamp(1500 / max(brand_len, 1), 54, 170))}}
{{/logo}}
{{#tagline}}
    set #tag y=72%
{{/tagline}}
