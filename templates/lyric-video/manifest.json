{
  "id": "lyric-video",
  "title": "Lyric video",
  "description": "Your lyrics, one line at a time on the beat of your song, with a karaoke sweep or a word-by-word rise.",
  "tags": ["audio", "music", "lyrics", "lyric video", "karaoke", "text"],
  "formats": ["16:9", "9:16", "1:1"],
  "duration_s": 16.6,
  "params": [
    {"id": "lyrics", "type": "longtext", "label": "Lyrics, one line per row", "max_len": 4000, "max_lines": 48, "max_line_len": 90,
     "default": "City lights are calling\nWindows down, the night is ours\nEvery signal turning green\nWe keep chasing after stars\nHold on, don't look back\nThe radio knows every word\nOut here we're never lost\nJust the road and what we heard",
     "timing": {"bpm": "bpm", "offset": "offset", "beats": "beats_per_line", "times": "times", "gap": 0}},
    {"id": "audio", "type": "audio", "label": "Song (mp3/wav)", "default": "night-drive.mp3"},
    {"id": "bpm", "type": "number", "label": "Tempo (bpm)", "default": 120, "min": 40, "max": 220, "step": 0.1},
    {"id": "offset", "type": "number", "label": "First line at (s)", "default": 0, "min": 0, "max": 600, "step": 0.01},
    {"id": "beats_per_line", "type": "number", "label": "Beats per line", "default": 4, "min": 1, "max": 32, "step": 1},
    {"id": "times", "type": "times", "label": "Line start times (s, optional; overrides the beat grid)", "default": ""},
    {"id": "title", "type": "text", "label": "Song title (optional)", "default": "Night Drive", "max_len": 48},
    {"id": "artist", "type": "text", "label": "Artist (optional)", "default": "AgentFX Audio", "max_len": 48},
    {"id": "style", "type": "enum", "label": "Style", "default": "karaoke", "options": ["karaoke", "rise"]},
    {"id": "text_color", "type": "color", "label": "Text colour", "default": "#FFFFFF"},
    {"id": "accent", "type": "color", "label": "Highlight", "default": "#FFB443"},
    {"id": "color2", "type": "color", "label": "Second light", "default": "#5B6CFF"},
    {"id": "bg", "type": "color", "label": "Background", "default": "#100C1C"}
  ]
}
