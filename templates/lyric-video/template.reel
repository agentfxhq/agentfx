// Lyric video (AgentFX template): one line at a time, timed on the song's beat grid (bpm, offset,
// beats per line) or by per-line times; colour light that breathes with the track behind it.
video "{{title}}" size=1920x1080 fps=30 captions=off formats=[16:9, 9:16, 1:1]

music src={{audio}} vol=1 bpm={{bpm}}

scene song dur={{= lyrics_end + 0.6}}s bg=radial(at 50% 50%, {{bg.rgb}} 0%, {{bg.rgb}} 50%, #000000 150%) optics vignette=0.45 film-grain=0.04 seed=9
  ellipse #glow1 w=1600 h=1600 x=28% y=60% anchor=center fill=radial(at 50% 50%, {{accent.rgb}}4D 0%, {{accent.rgb}}00 66%) opacity=audio(band=0.5, gain=0.8, offset=0.3, smooth=300ms)
  ellipse #glow2 w=1400 h=1400 x=74% y=38% anchor=center fill=radial(at 50% 50%, {{color2.rgb}}44 0%, {{color2.rgb}}00 66%) opacity=audio(band=4, gain=0.8, offset=0.25, smooth=360ms)
  anim #glow1 x 0s:0 {{= lyrics_end}}s:160~inout-sine
  anim #glow2 x 0s:0 {{= lyrics_end}}s:-180~inout-sine
  visualizer #floor type=bars count=64 w=1000 h=90 gap=6 colors=[{{ramp accent color2 64}}] gain=0.8 smooth=90ms x=50% y=94% anchor=bottom opacity=0.35
{{#title}}
  text #meta "{{title}}{{#artist}}  /  {{artist}}{{/artist}}" size=30 weight=600 color={{text_color.rgb}}99 tracking=0.2 upper x=50% y=7% anchor=center w=80% fit nowrap align=center
{{/title}}
  layer #lines x=0 y=0 w=100% h=100%
{{#lyrics}}
    text #l{{n}} "{{text}}" size={{= round(clamp(3200 / max(len, 1), 72, 110))}} weight=800 color={{#style=karaoke}}{{text_color.rgb}}66{{/style=karaoke}}{{^style=karaoke}}{{text_color}}{{/style=karaoke}} lh=1.08 tracking=-0.015 x=50% y=50% anchor=center w=82% align=center opacity=0
      anim opacity {{start}}s:0 {{= start + 0.12}}s:1 {{= max(start + 0.2, end - 0.18)}}s:1 {{end}}s:0
      anim y {{start}}s:30 {{= start + 0.5}}s:0~out-cubic {{= max(start + 0.5, end - 0.2)}}s:0 {{end}}s:-24~in-cubic
{{/lyrics}}
{{#lyrics}}
{{#style=karaoke}}
  @{{start}}s animate #l{{n}} by=char shape=ramp-down range=0%..8% offset=-8%..100% dur={{= max(0.3, (end - start) * 0.8)}}s ease=linear color={{accent}}
{{/style=karaoke}}
{{#style=rise}}
  @{{start}}s animate #l{{n}} by=word shape=ramp-up range=0%..30% offset=-30%..100% dur={{= clamp((end - start) * 0.5, 0.3, 1.2)}}s ease=linear opacity=0 y=50 blur=10
{{/style=rise}}
{{/lyrics}}
  pulse #lines on=beat amount=0.012 decay=200ms
  when portrait
{{#lyrics}}
    set #l{{n}} size={{= round(clamp(2400 / max(len, 1), 64, 100))}} w=84%
{{/lyrics}}
