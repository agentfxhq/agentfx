// Restaurant menu from a table. Sections flow into a grid of columns; type size follows the
// amount of content. Design units: short side 1080 (#page).
video "{{name}}" size={{W}}x{{H}} fps=30

theme {{#= bg_luma > 0.45}}studio-light{{/= bg_luma > 0.45}}{{^= bg_luma > 0.45}}studio-dark{{/= bg_luma > 0.45}}
  layout safe=0
  type min=14
  lint min-contrast=3 motion=false

{{: wide = A > 1.2}}
{{: m = 0.075*min(DW, DH)}}
{{: nsec = rows_groups_section}}
{{: hh = 275 if wide else 330}}
{{: fh = 80}}
{{: aw = DW - 2*m}}
{{: ah = DH - 2*m - hh - fh}}
{{: fd = rows_filled_description/rows_count}}
{{: c1 = 2 if wide else 1}}
{{: w1 = (aw - (c1 - 1)*70)/c1}}
{{: w2 = (aw - c1*70)/(c1 + 1)}}
{{: w3 = (aw - (c1 + 1)*70)/(c1 + 2)}}
{{: mr = rows_maxrun_section}}
{{: pi = 1.85 + 1.07*fd}}
{{: d1 = min(0.92*(ah - (ceil(nsec/c1) - 1)*70)/(ceil(nsec/c1)*(1.9 + mr*pi)), w1/10)}}
{{: d2 = min(0.92*(ah - (ceil(nsec/(c1 + 1)) - 1)*70)/(ceil(nsec/(c1 + 1))*(1.9 + mr*pi)), w2/10) if nsec > c1 else 0}}
{{: d3 = min(0.92*(ah - (ceil(nsec/(c1 + 2)) - 1)*70)/(ceil(nsec/(c1 + 2))*(1.9 + mr*pi)), w3/10) if nsec > c1 + 1 else 0}}
{{: n1 = min(0.92*(ah - (ceil(nsec/c1) - 1)*70)/(ceil(nsec/c1)*(1.9 + mr*1.85)), w1/10)}}
{{: n2 = min(0.92*(ah - (ceil(nsec/(c1 + 1)) - 1)*70)/(ceil(nsec/(c1 + 1))*(1.9 + mr*1.85)), w2/10) if nsec > c1 else 0}}
{{: n3 = min(0.92*(ah - (ceil(nsec/(c1 + 2)) - 1)*70)/(ceil(nsec/(c1 + 2))*(1.9 + mr*1.85)), w3/10) if nsec > c1 + 1 else 0}}
{{: dbest = max(d1, d2, d3)}}
{{: showdesc = fd > 0 and dbest >= 24}}
{{: best = dbest if showdesc else max(n1, n2, n3)}}
{{: cols = min(nsec, (c1 if best == (d1 if showdesc else n1) else (c1 + 1 if best == (d2 if showdesc else n2) else c1 + 2)))}}
{{: cg = 70 if cols > 1 else 0}}
{{: colw = (aw - (cols - 1)*cg)/cols}}
{{: isz0 = clamp(best, 18, 48)}}
{{: pl = max(3.2, 0.56*(rows_maxlen_price + (0 if currency_pos_none else currency_len + 1)))}}
{{: pw = isz0*pl}}
{{: fw = 2 if rows_maxlen_item*0.5*isz0 > 1.3*(colw - pw - 24) else (1.25 if rows_maxlen_item*0.5*isz0 > colw - pw - 24 else 1)}}
{{: fdw = min(3, 0.25 + 0.75*ceil(rows_maxlen_description*0.36*isz0/(colw - pw - 24)))}}
{{: pi2 = 0.6 + 1.3*fw + (fd*(0.12 + 0.86*max(fdw, 1)) if showdesc else 0)}}
{{: isz = clamp(min(isz0, 0.96*(ah - (ceil(nsec/cols) - 1)*70)/(ceil(nsec/cols)*(1.9 + mr*pi2))), 16, 48)}}
{{: pw = isz*pl}}
scene menu dur=60s bg={{bg}}
  layer #page w={{DW}} h={{DH}} x=0 y=0 scale={{S}} origin=top-left
    rect #frame w={{= DW - m}} h={{= DH - m}} x=50% y=50% anchor=center radius=6 stroke={{accent}} sw=2 opacity=0.55
    text #name "{{name}}" font="{{font}}" size={{= 118 if wide else 128}} weight=700 lh=1 tracking=-0.015 color={{ink}} align=center w={{= aw - 80}} h={{= 130 if wide else 150}} x=50% y={{= 100*(m + 30)/DH}}% anchor=top fit nowrap
    row #orn gap=22 align=center x=50% y={{= 100*(m + (178 if wide else 205))/DH}}% anchor=center
      rect #orn1 w=120 h=2 fill={{accent}}
      rect #orn2 w=14 h=14 fill={{accent}} rot=45
      rect #orn3 w=120 h=2 fill={{accent}}
{{#tagline}}
    text #tagline "{{tagline}}" font="Space Grotesk" size=30 weight=600 tracking=0.2 upper color={{accent}} align=center w={{= aw - 120}} h=44 x=50% y={{= 100*(m + (212 if wide else 245))/DH}}% anchor=top fit nowrap
{{/tagline}}
    grid #menu cols={{cols}} cols-portrait={{cols}} gap={{cg}} align=start justify=start w={{= aw}} x={{= 100*m/DW}}% y={{= 100*(m + hh)/DH}}%
{{#rows}}
{{#@changed.section}}
      col #s{{@n}} gap={{= isz*0.6}} align=start justify=start w={{= colw}}
        text #s{{@n}}h "{{.section}}" font="Space Grotesk" size={{= max(isz*0.78, 16)}} weight=700 tracking=0.18 upper color={{accent}} align=left w={{= colw}} h={{= isz*1.3}} fit nowrap
{{/@changed.section}}
        row #i{{@n}} gap=24 align=start justify=space-between w={{= colw}}
          col #i{{@n}}t gap={{= isz*0.12}} align=start w={{= colw - pw - 24}}
            text #i{{@n}}n "{{.item}}" font="{{font}}" size={{= isz}} weight=600 lh=1.15 color={{ink}} align=left w={{= colw - pw - 24}} h={{= isz*1.2*(2 if row_item_len*0.5*isz > colw - pw - 24 else 1)}} fit
{{#.description}}
{{#= showdesc}}
            text #i{{@n}}d "{{.description}}" font="Inter" size={{= max(isz*0.66, 16)}} weight=400 lh=1.3 color={{ink}} opacity=0.72 align=left w={{= colw - pw - 24}} h={{= max(isz*0.66, 16)*1.3*min(3, ceil(row_description_len*0.36*isz/(colw - pw - 24)))}} fit
{{/= showdesc}}
{{/.description}}
{{#.price}}
          text #i{{@n}}p "{{#currency_pos=before}}{{currency}} {{/currency_pos=before}}{{.price}}{{#currency_pos=after}} {{currency}}{{/currency_pos=after}}" font="{{font}}" size={{= isz}} weight=600 color={{ink}} align=right w={{= pw}} h={{= isz*1.25}} fit nowrap
{{/.price}}
{{/rows}}
{{#footer}}
    text #footer "{{footer}}" font="Inter" size=26 weight=500 color={{ink}} opacity=0.7 align=center w={{= aw - 80}} h=40 x=50% y={{= 100*(DH - m - 30)/DH}}% anchor=bottom fit nowrap
{{/footer}}
