// Mockup: a screenshot on a phone in stylised 3D (perspective-correct screen texture) or on a
// laptop, or artwork printed on a t-shirt (multiplied into the fabric shading). Design units:
// short side 1080 (#page).
video "{{headline}}" size={{W}}x{{H}} fps=30

theme {{#= bg_luma > 0.45}}studio-light{{/= bg_luma > 0.45}}{{^= bg_luma > 0.45}}studio-dark{{/= bg_luma > 0.45}}
  layout safe=0
  lint min-contrast=3 motion=false

{{: wide = A > 1.3}}
{{: txt = headline_len > 0 or subline_len > 0}}
{{: rx = (DW*0.44 if txt else DW*0.1) if wide else DW*0.06}}
{{: ry = DH*0.05 if wide else (DH*(0.33 if A < 0.7 else 0.3) if txt else DH*0.06)}}
{{: rw = (DW*0.52 if txt else DW*0.8) if wide else DW*0.88}}
{{: rh = DH*0.9 if wide else (DH*(0.6 if A < 0.7 else 0.66) if txt else DH*0.88)}}
{{: cx = rx + rw/2}}
{{: cy = ry + rh/2}}
scene mockup dur=60s bg={{bg}}
  layer #page w={{DW}} h={{DH}} x=0 y=0 scale={{S}} origin=top-left
    rect #glow w={{DW}} h={{DH}} x=0 y=0 fill=radial(at {{= 100*cx/DW}}% {{= 100*cy/DH}}%, {{bg2.rgb}}D0 0%, {{bg2.rgb}}00 {{= 55 if wide else 60}}%)
{{#= txt}}
    col #words gap=30 align=start x={{= 6 if wide else 8}}% y={{= 50 if wide else (12 if A < 0.7 else 7)}}% anchor={{#= wide}}left{{/= wide}}{{^= wide}}top-left{{/= wide}} w={{= DW*(0.36 if wide else 0.84)}}
{{#headline}}
      text #headline "{{headline}}" font="Space Grotesk" size={{= 96 if wide else 92}} weight=700 lh=1.02 tracking=-0.025 color={{ink}} align=left w={{= DW*(0.36 if wide else 0.84)}} h={{= DH*(0.34 if wide else (0.12 if A < 0.7 else 0.14))}} fit
{{/headline}}
{{#subline}}
      text #subline "{{subline}}" font="Inter" size=38 weight=400 lh=1.35 color={{ink}} opacity=0.75 align=left w={{= DW*(0.34 if wide else 0.8)}} h={{= DH*(0.16 if wide else 0.07)}} fit
{{/subline}}
{{/= txt}}
{{#type=phone}}
{{#phone_screen}}
    image #shot src={{phone_screen}} fit=cover x=0 y=0 w=900 h=1950
    scene3d #stage w={{= rw}} h={{= rh}} x={{= 100*rx/DW}}% y={{= 100*ry/DH}}% fov=26 camera=(1.6, 0.9, 9.2) target=(0, -0.1, 0) light=(-4, 6, 7) ambient=0.6 aa=3 shadow=0.3 shadow-blur=24 outline=0
      floor y=-1.72 color={{bg}} size=40
      group #phone ry=-26 rx=6 rz=-2
        box #body w=1.62 h=3.32 d=0.2 bevel=0.09 color=#16181D material=phong shininess=60 specular=0.35
        screen #glass w=1.5 h=3.2 z=0.101 src=#shot
{{/phone_screen}}
{{/type=phone}}
{{#type=laptop}}
{{#laptop_screen}}
    image #shot src={{laptop_screen}} fit=cover x=0 y=0 w=1600 h=1000
    scene3d #stage w={{= rw}} h={{= rh}} x={{= 100*rx/DW}}% y={{= 100*ry/DH}}% fov=26 camera=(2.2, 2.4, 9.5) target=(0, 0.55, 0) light=(-4, 7, 6) ambient=0.6 aa=3 shadow=0.3 shadow-blur=24 outline=0
      floor y=-0.06 color={{bg}} size=40
      group #laptop ry=-22
        box #base w=4.1 h=0.12 d=2.75 bevel=0.05 color=#C9CDD4 material=phong shininess=40 specular=0.3
        box #pad w=1.3 h=0.01 d=0.8 y=0.065 z=0.85 color=#BCC1C8 material=flat
        group #lid y=0.06 z=-1.36 rx=-12
          box #lidbody w=4.1 h=2.66 d=0.08 y=1.33 bevel=0.04 color=#2A2D33 material=phong shininess=50
          screen #glass w=3.84 h=2.4 y=1.36 z=0.041 src=#shot
{{/laptop_screen}}
{{/type=laptop}}
{{#type=tshirt}}
{{: tw = min(rw, rh)}}
    image #tee src=tshirt.png fit=contain w={{= tw}} h={{= tw}} x={{= 100*cx/DW}}% y={{= 100*cy/DH}}% anchor=center
    rect #dye w={{= tw}} h={{= tw}} x={{= 100*cx/DW}}% y={{= 100*cy/DH}}% anchor=center fill={{shirt}} mask=image(tshirt.png contain) blend=multiply
{{#artwork}}
    image #print src={{artwork}} fit=contain w={{= tw*0.3}} h={{= tw*0.3}} x={{= 100*cx/DW}}% y={{= 100*(cy - tw*0.07)/DH}}% anchor=center{{#= shirt_luma > 0.35}} blend=multiply{{/= shirt_luma > 0.35}} opacity=0.96
{{/artwork}}
{{/type=tshirt}}
