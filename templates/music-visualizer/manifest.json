{
  "id": "music-visualizer",
  "title": "Music visualizer",
  "description": "Audio-reactive spectrum, radial ring or waveform with your title and artist, for any song.",
  "tags": ["audio", "music", "visualizer", "spectrum", "audio visualizer"],
  "formats": ["16:9", "9:16", "1:1"],
  "duration_s": 16,
  "params": [
    {"id": "title", "type": "text", "label": "Title", "default": "Night Drive", "max_len": 48},
    {"id": "artist", "type": "text", "label": "Artist", "default": "AgentFX Audio", "max_len": 48},
    {"id": "style", "type": "enum", "label": "Style", "default": "radial", "options": ["bars", "radial", "waveform"]},
    {"id": "audio", "type": "audio", "label": "Music (mp3/wav)", "default": "night-drive.mp3"},
    {"id": "duration", "type": "number", "label": "Length (s)", "default": 16, "min": 3, "max": 120, "step": 1},
    {"id": "sensitivity", "type": "number", "label": "Sensitivity", "default": 1, "min": 0.5, "max": 2, "step": 0.1},
    {"id": "color1", "type": "color", "label": "Colour 1", "default": "#7C5CFF"},
    {"id": "color2", "type": "color", "label": "Colour 2", "default": "#2EE6D6"},
    {"id": "bg", "type": "color", "label": "Background", "default": "#0C0A1A"},
    {"id": "text_color", "type": "color", "label": "Text colour", "default": "#FFFFFF"}
  ]
}
