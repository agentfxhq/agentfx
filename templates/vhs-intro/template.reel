// VHS intro (AgentFX template): a tape that finds its picture. Blue screen and tracking noise,
// the deck locks on, a retro title holds under scanlines and chroma bleed, the tape stops.
video "{{title}}" size=1920x1080 fps=30 captions=off formats=[16:9, 9:16, 1:1]

scene tape dur=6s bg={{bg}} optics vignette=0.55 halation=0.35 film-grain=0.06
  layer #tape x=0 y=0 w=100% h=100% vhs=1 seed={{seed}}
    // the picture: a horizon sun over a floor of light
    layer #pic x=0 y=0 w=100% h=100%
      rect #sky w=100% h=100% x=0 y=0 fill=linear(180deg, {{bg.rgb}} 0%, {{color2.rgb}}55 58%, {{bg.rgb}} 58.2%, #000000 100%)
      layer #sun x=50% y=58% w=620 h=620 anchor=bottom
        ellipse x=0 y=0 w=620 h=620 fill=linear(180deg, {{color1}} 0%, {{color2}} 100%) glow=40 glow-color={{color2}}
        rect x=0 y=380 w=620 h=10 fill=#000000 knockout
        rect x=0 y=430 w=620 h=16 fill=#000000 knockout
        rect x=0 y=482 w=620 h=22 fill=#000000 knockout
        rect x=0 y=540 w=620 h=30 fill=#000000 knockout
        rect x=0 y=600 w=620 h=40 fill=#000000 knockout
        anim y 0s:60 6s:0~out-cubic
      rect #l1 w=100% h=2 x=0 y=62% fill={{color2.rgb}}80
      rect #l2 w=100% h=3 x=0 y=68% fill={{color2.rgb}}70
      rect #l3 w=100% h=4 x=0 y=77% fill={{color2.rgb}}60
      rect #l4 w=100% h=5 x=0 y=90% fill={{color2.rgb}}50
      text #title "{{title}}" size=190 weight=900 color={{text_color}} tracking=-0.01 x=50% y=46% anchor=center w=78% fit nowrap align=center upper stroke={{color2.rgb}} sw=3 glow=26 glow-color={{color1}} rot=-4
      text #sub "{{sub}}" size=44 weight=700 color={{color1}} tracking=0.5 x=50% y=63% anchor=center w=80% fit nowrap align=center upper
    // snow between tape and picture
    rect #snow x=0 y=0 w=100% h=100% fill=#8A8A96 grain=1 grain-mode=live grain-size=2
      anim opacity 0s:1 0.7s:1 0.72s:0~steps(1) 5.3s:0 5.32s:1~steps(1)
    // on-screen display, always on top
    text #osd "{{osd}}" size=58 weight=700 font=mono color=#FFFFFF x=6% y=8% nowrap
      anim opacity 0s:1 3.2s:1 3.22s:0~steps(1)
    text #sp "SP" size=58 weight=700 font=mono color=#FFFFFF x=94% y=8% anchor=top-right nowrap
    text #clock "{{stamp}}" size=46 weight=700 font=mono color=#FFFFFF x=6% y=90% anchor=bottom-left nowrap
  anim #pic opacity 0s:0 0.7s:0 0.72s:1~steps(1) 5.3s:1 5.32s:0~steps(1)
  anim #pic y 0.72s:-140 0.8s:40 0.9s:-12 1.0s:0~steps(1) 2.6s:0 2.64s:-18 2.72s:0~steps(1)
  anim #title scale 0.72s:1.12 1.3s:1~out-cubic
  @1.1s animate #sub by=char shape=ramp-up range=0%..20% offset=-20%..100% dur=0.9s ease=linear opacity=0
  // tracking: the scene's tape noise is heavy until the deck locks, then a band rolls through once
  anim #tape vhs 0s:1 0.7s:1 0.9s:{{= 0.35 * wear}}~out-cubic 2.6s:{{= 0.35 * wear}} 2.65s:0.9 2.9s:{{= 0.35 * wear}}~out-cubic 5.1s:{{= 0.35 * wear}} 5.3s:1
  when portrait
    set #title size=150 rot=-5
    set #sun w=560 h=560
  when square
    set #title size=150
