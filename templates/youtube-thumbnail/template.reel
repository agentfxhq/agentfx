// YouTube thumbnail: huge two-line text, cut-out subject, accent shape. Design units 1920x1080.
video "{{line1}} {{line2}}" size={{W}}x{{H}} fps=30

theme studio-dark
  layout safe=0
  lint min-contrast=3 motion=false

{{: sx = 72 if side_right else 28}}
scene thumb dur=60s bg={{bg}}
  layer #page w={{DW}} h={{DH}} x=0 y=0 scale={{S}} origin=top-left
    rect #glow w={{DW}} h={{DH}} x=0 y=0 fill=radial(at {{sx}}% 55%, {{bg2.rgb}} 0%, {{bg2.rgb}}00 62%)
{{#shape=burst}}
    star #burst points=18 inner=0.74 w={{= DH*0.92}} h={{= DH*0.92}} x={{sx}}% y=50% anchor=center fill={{accent}} opacity=0.92
{{/shape=burst}}
{{#shape=circle}}
    ellipse #ring w={{= DH*0.86}} h={{= DH*0.86}} x={{sx}}% y=50% anchor=center stroke={{accent}} sw=18
{{/shape=circle}}
{{#image}}
    image #subject src={{image}} fit=contain w={{= DW*0.46}} h={{= DH*0.96}} x={{sx}}% y=100% anchor=bottom
{{/image}}
{{#shape=arrow}}
    svg #arrow w=300 h=240 x=42.2% y=6% |
      <svg viewBox="0 0 300 240">{{#side=right}}<path d="M24 44 C 120 -4, 236 36, 252 176" fill="none" stroke="{{accent.rgb}}" stroke-width="20" stroke-linecap="round"/><path d="M206 146 L254 196 L288 132" fill="none" stroke="{{accent.rgb}}" stroke-width="20" stroke-linecap="round" stroke-linejoin="round"/>{{/side=right}}{{#side=left}}<path d="M276 44 C 180 -4, 64 36, 48 176" fill="none" stroke="{{accent.rgb}}" stroke-width="20" stroke-linecap="round"/><path d="M94 146 L46 196 L12 132" fill="none" stroke="{{accent.rgb}}" stroke-width="20" stroke-linecap="round" stroke-linejoin="round"/>{{/side=left}}</svg>
{{/shape=arrow}}
    col #words gap=18 align=start x={{= 4.5 if side_right else 47.5}}% y=54% anchor=left w={{= DW*0.5}}
      text #line1 "{{line1}}" font="Inter" size=172 weight=900 lh=0.92 tracking=-0.03 upper color={{ink}} stroke=#000000 sw=10 align=left w={{= DW*0.5}} h=175 fit nowrap
{{#line2}}
      row #line2box fill={{accent}} pad=26 radius=12 rot=-2 shadow=lg
        text #line2 "{{line2}}" font="Inter" size=150 weight=900 lh=0.95 tracking=-0.03 upper color={{bg}} align=left w={{= DW*0.47}} h=160 fit nowrap
{{/line2}}
{{#badge}}
    row #badgebox fill=#E8263B pad=22 radius=16 rot=4 shadow=lg x={{= 95.5 if side_right else 4.5}}% y=8% anchor={{#side=right}}top-right{{/side=right}}{{#side=left}}top-left{{/side=left}}
      text #badge "{{badge}}" font="Inter" size=64 weight=900 color=#FFFFFF nowrap
{{/badge}}
