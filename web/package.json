{
  "name": "agentfx-playground",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "AgentFX web playground: template mode and a light timeline studio for Reel Script",
  "scripts": {
    "dev": "vite",
    "mock": "python3 dev/mock_api.py",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "python3 e2e/e2e.py"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.18.0",
    "@codemirror/commands": "^6.8.0",
    "@codemirror/language": "^6.11.0",
    "@codemirror/lint": "^6.8.0",
    "@codemirror/search": "^6.5.0",
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.36.0",
    "@lezer/highlight": "^1.2.0",
    "preact": "^10.27.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "typescript": "~5.9.0",
    "vite": "^7.3.0",
    "vitest": "^4.0.0"
  }
}
